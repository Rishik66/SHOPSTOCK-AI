# Supabase Cloud Database Configuration (Optional)
# If provided, ShopStock AI automatically syncs user accounts, products, and sales to Supabase.
# If omitted, ShopStock AI operates in offline-ready LocalStorage mode.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Google Gemini Real-Time AI Configuration (Optional)
# Get a free key at: https://aistudio.google.com/app/apikey
# If provided, enables live generative AI chat, reasoning, and store consulting.
# Can also be entered by the user in Settings or AI Assistant.
VITE_GEMINI_API_KEY=your-gemini-api-key-here

